+bool PhysicalHeap::IsStaleWriteFault(uint32_t virtual_address) const {
+  if (virtual_address < heap_base_) {
+    return false;
+  }
+  const uint32_t heap_relative_address = virtual_address - heap_base_;
+  if (heap_relative_address >= heap_size_) {
+    return false;
+  }
+  const uint32_t system_page = (heap_relative_address + host_address_offset()) / system_page_size_;
+  if (system_page >= system_page_count_ || IsHostPageWriteWatched(system_page)) {
+    return false;
+  }
+  const uint32_t guest_page_number =
+      rex::sat_sub(system_page * system_page_size_, host_address_offset()) >> page_size_shift_;
+  if (guest_page_number >= page_table_.size()) {
+    return false;
+  }
+  return ToPageAccess(page_table_[guest_page_number].current_protect) ==
+         rex::memory::PageAccess::kReadWrite;
+}
