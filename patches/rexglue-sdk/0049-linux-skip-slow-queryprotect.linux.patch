+bool IsQueryProtectCheap() {
+#if REX_PLATFORM_LINUX
+  // Probe once whether the kernel answers PROCMAP_QUERY (6.11+). Without it every QueryProtect parses
+  // the whole /proc/self/maps, which costs hundreds of microseconds with a fragmented address space.
